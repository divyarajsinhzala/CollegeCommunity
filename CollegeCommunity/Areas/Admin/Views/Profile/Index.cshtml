@model CollegeCommunity.Models.Student
@{
    ViewBag.Title = "Admin Profile";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div style="display: flex; flex-direction: column; gap: var(--spacing-lg); max-width: 900px; margin: 0 auto;">

    <!-- Profile Header Card -->
    <div class="card glass-panel" style="display: flex; align-items: center; gap: 30px; padding: 40px; border-top: 4px solid var(--color-danger);">
        <div style="width: 120px; height: 120px; background: url('https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.FirstName + " " + Model.LastName)&background=e65a6b&color=fff&size=120') center/cover; border-radius: 50%; box-shadow: 0 10px 20px rgba(230, 90, 107, 0.3);"></div>
        <div style="flex: 1;">
            <div style="display: flex; align-items: center; gap: 15px;">
                <h1 style="margin: 0 0 5px 0; font-size: 2.2rem;">@Model.FirstName @Model.LastName</h1>
                <span style="background: rgba(230, 90, 107, 0.2); color: var(--color-danger); padding: 4px 12px; border-radius: 12px; font-size: 0.8rem; font-weight: bold; border: 1px solid rgba(230, 90, 107, 0.5);">SYSTEM ADMIN</span>
            </div>
            <p style="margin: 5px 0 0 0; color: var(--color-text-secondary);"><i class="fa-regular fa-envelope"></i> @Model.CollegeEmail</p>
        </div>
    </div>

    <!-- Administrative Information -->
    <div class="card glass-panel">
        <h3 style="margin-top: 0; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;"><i class="fa-solid fa-shield-halved" style="color: var(--color-danger); margin-right: 10px;"></i> Administrative Identity</h3>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
            <div>
                <small style="color: var(--color-text-secondary); display: block; margin-bottom: 5px;">Admin ID / Enrollment</small>
                <div style="font-size: 1.1rem; font-weight: 500; color: var(--color-danger);">@Model.EnrollmentNo</div>
            </div>
            <div>
                <small style="color: var(--color-text-secondary); display: block; margin-bottom: 5px;">Department Affiliation</small>
                <div style="font-size: 1.1rem; font-weight: 500;">@Model.Department</div>
            </div>
            <div>
                <small style="color: var(--color-text-secondary); display: block; margin-bottom: 5px;">Clearance Level</small>
                <div style="font-size: 1.1rem; font-weight: 500;">Tier 1 (Full Access)</div>
            </div>
        </div>
    </div>

    <!-- Personal Information -->
    <div class="card glass-panel">
        <h3 style="margin-top: 0; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;"><i class="fa-regular fa-address-card" style="color: var(--color-text-secondary); margin-right: 10px;"></i> Contact Details</h3>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
            <div>
                <small style="color: var(--color-text-secondary); display: block; margin-bottom: 5px;">Mobile Number</small>
                <div style="font-size: 1.1rem; font-weight: 500;">+91 @Model.MobileNo</div>
            </div>
            <div>
                <small style="color: var(--color-text-secondary); display: block; margin-bottom: 5px;">Account Origin</small>
                <div style="font-size: 1.1rem; font-weight: 500;">Promoted from @Model.Branch</div>
            </div>
        </div>
    </div>
</div>