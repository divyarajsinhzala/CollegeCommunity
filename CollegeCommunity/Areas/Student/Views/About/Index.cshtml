@{
    ViewBag.Title = "About Us";
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";
}

<div class="card glass-panel" style="max-width: 800px; margin: 0 auto; padding: 40px;">
    <div style="text-align: center; margin-bottom: 40px;">
        <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #4776e6, #8e54e9); border-radius: 20px; display: grid; place-items: center; margin: 0 auto 15px auto; box-shadow: 0 10px 20px rgba(71, 118, 230, 0.3);">
            <i class="fa-solid fa-graduation-cap" style="font-size: 2.5rem; color: white;"></i>
        </div>
        <h2 style="margin: 0 0 10px 0; font-size: 2rem;">College Community Platform</h2>
        <span style="background: rgba(255,255,255,0.1); padding: 4px 12px; border-radius: 12px; font-size: 0.85rem; color: var(--color-accent);">Version 1.2.0 • Stable Release</span>
    </div>

    <div style="margin-bottom: 40px;">
        <h3 style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; margin-bottom: 15px; color: var(--color-primary-light);"><i class="fa-solid fa-rocket" style="margin-right: 10px;"></i> Our Mission</h3>
        <p style="color: var(--color-text-secondary); line-height: 1.7; font-size: 1.05rem;">
            This application was engineered to unify campus life. By consolidating administrative announcements, event scheduling, dynamic club rosters, and secure peer-to-peer chatrooms into a single, intuitive interface, we aim to bridge the gap between students and administration while fostering a stronger, more engaged academic community.
        </p>
    </div>

    <div style="margin-bottom: 40px;">
        <h3 style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; margin-bottom: 20px; color: var(--color-primary-light);"><i class="fa-solid fa-layer-group" style="margin-right: 10px;"></i> Core Modules</h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
            <div style="background: rgba(0,0,0,0.2); padding: 15px; border-radius: 8px; border-left: 3px solid #4776e6;">
                <strong style="color: white; display: block; margin-bottom: 5px;">Club Directory</strong>
                <span style="color: var(--color-text-secondary); font-size: 0.85rem;">Join organizations and manage your active memberships seamlessly.</span>
            </div>
            <div style="background: rgba(0,0,0,0.2); padding: 15px; border-radius: 8px; border-left: 3px solid #f4b400;">
                <strong style="color: white; display: block; margin-bottom: 5px;">Real-Time Chat</strong>
                <span style="color: var(--color-text-secondary); font-size: 0.85rem;">Isolated communication channels locked directly to your enrolled clubs.</span>
            </div>
            <div style="background: rgba(0,0,0,0.2); padding: 15px; border-radius: 8px; border-left: 3px solid #38c6c0;">
                <strong style="color: white; display: block; margin-bottom: 5px;">Live Broadcasts</strong>
                <span style="color: var(--color-text-secondary); font-size: 0.85rem;">Instant global alerts and announcements deployed by the administration.</span>
            </div>
            <div style="background: rgba(0,0,0,0.2); padding: 15px; border-radius: 8px; border-left: 3px solid #e65a6b;">
                <strong style="color: white; display: block; margin-bottom: 5px;">Control Center</strong>
                <span style="color: var(--color-text-secondary); font-size: 0.85rem;">Comprehensive backend dashboard for moderation and system lockdowns.</span>
            </div>
        </div>
    </div>

    <div>
        <h3 style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; margin-bottom: 15px; color: var(--color-primary-light);"><i class="fa-solid fa-code" style="margin-right: 10px;"></i> Technology Stack</h3>
        <ul style="color: var(--color-text-secondary); line-height: 2; list-style-type: none; padding-left: 0;">
            <li><i class="fa-brands fa-microsoft" style="color: #4776e6; width: 25px;"></i> <strong>Backend Architecture:</strong> C# ASP.NET MVC Framework</li>
            <li><i class="fa-solid fa-database" style="color: #f4b400; width: 25px;"></i> <strong>Database ORM:</strong> SQL Server via Entity Framework (Code-First)</li>
            <li><i class="fa-brands fa-html5" style="color: #e65a6b; width: 25px;"></i> <strong>Frontend UI/UX:</strong> HTML5, CSS Variables, Custom Glass-Neumorphism</li>
            <li><i class="fa-brands fa-js" style="color: #f4b400; width: 25px;"></i> <strong>Client Scripting:</strong> Vanilla JavaScript & FontAwesome Icons</li>
        </ul>
    </div>
</div>