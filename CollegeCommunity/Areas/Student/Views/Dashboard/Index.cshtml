@model CollegeCommunity.ViewModels.StudentDashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";
}

<style>
    .quick-action-btn {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100px;
        border: 1px solid rgba(255,255,255,0.1) !important;
        backdrop-filter: blur(12px);
    }

        .quick-action-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
            border-color: rgba(255,255,255,0.3) !important;
        }

    .content-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: var(--spacing-lg);
        align-items: stretch;
    }

    .flex-card {
        display: flex;
        flex-direction: column;
        flex: 1;
    }
</style>

<div class="dashboard-layout" style="display: flex; flex-direction: column; gap: var(--spacing-lg);">

    <!-- HERO SECTION -->
    <div class="card dashboard-hero glass-panel" style="margin-bottom: 0;">
        <div>
            <h4 style="margin: 0; font-weight: 400; color: var(--color-text-secondary);">Good Morning,</h4>
            <h1 style="margin: 5px 0 10px 0; font-size: 2.5rem;">@Model.StudentFirstName 👋</h1>
            <p style="margin: 0; color: var(--color-text-secondary);">Keep learning, keep growing.</p>
        </div>
        <div style="border-left: 2px solid var(--color-accent); padding-left: 20px; max-width: 200px;">
            <p style="margin: 0; font-style: italic; font-size: 0.9rem;">"Small steps every day lead to big dreams."</p>
        </div>
        <div class="hero-stats">
            <div class="stat-box" style="background: rgba(71, 118, 230, 0.2) !important;">
                <i class="fa-solid fa-users" style="color: #4776e6; font-size: 1.5rem; margin-bottom: 5px;"></i>
                <h3 style="margin:0;">@Model.TotalStudents</h3>
                <small style="color: var(--color-text-secondary);">Students</small>
            </div>
            <div class="stat-box" style="background: rgba(56, 198, 192, 0.2) !important;">
                <i class="fa-solid fa-cubes" style="color: var(--color-accent); font-size: 1.5rem; margin-bottom: 5px;"></i>
                <h3 style="margin:0;">@Model.TotalClubs</h3>
                <small style="color: var(--color-text-secondary);">Clubs</small>
            </div>
            <div class="stat-box" style="background: rgba(244, 180, 0, 0.2) !important;">
                <i class="fa-regular fa-calendar-check" style="color: #f4b400; font-size: 1.5rem; margin-bottom: 5px;"></i>
                <h3 style="margin:0;">@Model.TotalEvents</h3>
                <small style="color: var(--color-text-secondary);">Events</small>
            </div>
            <div class="stat-box" style="background: rgba(230, 90, 107, 0.2) !important;">
                <i class="fa-solid fa-bullhorn" style="color: var(--color-danger); font-size: 1.5rem; margin-bottom: 5px;"></i>
                <h3 style="margin:0;">@Model.TotalAlerts</h3>
                <small style="color: var(--color-text-secondary);">Alerts</small>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
        <!-- Blue/Purple -->
        <button class="quick-action-btn card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 15px 10px; background: linear-gradient(135deg, rgba(71,118,230,0.8), rgba(142,84,233,0.8)); color: white; cursor: pointer; margin: 0;" onclick="location.href='@Url.Action("Index", "Events", new { area = "Student" })'">
            <i class="fa-regular fa-calendar-plus" style="font-size: 1.8rem; margin: 0;"></i>
            <span style="font-weight: 500; font-size: 1rem;">Join Event</span>
        </button>
        <!-- Darker Blue Glass -->
        <button class="quick-action-btn card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 15px 10px; background: linear-gradient(135deg, rgba(30,60,114,0.85), rgba(42,82,152,0.85)); color: white; cursor: pointer; margin: 0;" onclick="location.href='@Url.Action("Index", "Clubs", new { area = "Student" })'">
            <i class="fa-solid fa-users-viewfinder" style="font-size: 1.8rem; margin: 0;"></i>
            <span style="font-weight: 500; font-size: 1rem;">Explore Clubs</span>
        </button>
        <!-- Orange/Yellow -->
        <button class="quick-action-btn card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 15px 10px; background: linear-gradient(135deg, rgba(244,107,69,0.8), rgba(238,168,73,0.8)); color: white; cursor: pointer; margin: 0;" onclick="location.href='@Url.Action("Index", "Announcements", new { area = "Student" })'">
            <i class="fa-solid fa-bullhorn" style="font-size: 1.8rem; margin: 0;"></i>
            <span style="font-weight: 500; font-size: 1rem;">Announcements</span>
        </button>
        <!-- Pink/Orange -->
        <button class="quick-action-btn card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 15px 10px; background: linear-gradient(135deg, rgba(238,9,121,0.8), rgba(255,106,0,0.8)); color: white; cursor: pointer; margin: 0;" onclick="location.href='@Url.Action("Index", "Chat", new { area = "Student" })'">
            <i class="fa-solid fa-magnifying-glass" style="font-size: 1.8rem; margin: 0;"></i>
            <span style="font-weight: 500; font-size: 1rem;">Find People</span>
        </button>
    </div>

    <!-- MAIN CONTENT GRID -->
    <div class="content-grid">

        <!-- COLUMN 1: Events -->
        <div class="card glass-panel flex-card">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; margin-bottom: 10px;">
                <h3 style="margin:0;"><i class="fa-regular fa-calendar-days" style="color: var(--color-text-secondary); margin-right: 10px;"></i> Upcoming Events</h3>
                <a href="@Url.Action("Index", "Events", new { area = "Student" })" class="view-all-link">View All</a>
            </div>
            <div class="list-group" style="flex: 1; display: flex; flex-direction: column;">
                @if (Model.UpcomingEvents != null && Model.UpcomingEvents.Any())
                {
                    foreach (var evt in Model.UpcomingEvents)
                    {
                        var bgImage = string.IsNullOrEmpty(evt.ImageUrl) ? "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&q=80" : evt.ImageUrl;
                        <div class="list-item" style="padding: 12px 10px; background: transparent; box-shadow: none; border-bottom: 1px solid rgba(255,255,255,0.05); flex: 1;">
                            <div style="display: flex; gap: 15px; align-items: center; width: 100%;">
                                <div style="width: 50px; height: 50px; background: url('@bgImage') center/cover; border-radius: 8px; flex-shrink: 0;"></div>
                                <div style="min-width: 0; flex: 1;">
                                    <h4 style="font-size: 1rem; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@evt.Title</h4>
                                    <div class="item-meta"><i class="fa-regular fa-calendar"></i> @evt.EventDate.ToString("MMM dd • hh:mm tt")</div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; color: var(--color-text-secondary); padding: 30px 10px; margin: auto;">No upcoming events scheduled.</div>
                }
            </div>
        </div>

        <!-- COLUMN 2: Announcements -->
        <div class="card glass-panel flex-card">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; margin-bottom: 10px;">
                <h3 style="margin:0;"><i class="fa-solid fa-bullhorn" style="color: var(--color-text-secondary); margin-right: 10px;"></i> Announcements</h3>
                <a href="@Url.Action("Index", "Announcements", new { area = "Student" })" class="view-all-link">View All</a>
            </div>
            <div class="list-group" style="flex: 1; display: flex; flex-direction: column;">
                @if (Model.Announcements != null && Model.Announcements.Any())
                {
                    int index = 0;
                    string[] cycleColors = { "#8e54e9", "#2a5298", "#f46b45", "#ee0979" };

                    foreach (var ann in Model.Announcements)
                    {
                        var rowColor = cycleColors[index % 4];
                        index++;

                        <div class="list-item" style="background: transparent; align-items: flex-start; box-shadow: none; padding: 15px 10px; border-left: 3px solid @rowColor; margin-bottom: 5px; border-bottom: 1px solid rgba(255,255,255,0.05); flex: 1;">
                            <div style="flex: 1; min-width: 0; padding-left: 5px;">
                                <h4 style="margin:0 0 4px 0; font-size: 0.95rem;">@ann.Title</h4>
                                <p style="margin:0; font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.4;">@ann.Description</p>
                                <small style="color: var(--color-text-secondary); opacity: 0.7; display: block; margin-top: 6px;">@ann.DatePosted.ToString("MMM dd")</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; color: var(--color-text-secondary); padding: 30px 10px; margin: auto;">No new announcements.</div>
                }
            </div>
        </div>

        <!-- COLUMN 3: Recent Chats -->
        <div class="card glass-panel flex-card">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; margin-bottom: 10px;">
                <h3 style="margin:0;"><i class="fa-regular fa-comments" style="color: var(--color-text-secondary); margin-right: 10px;"></i> Joined Club Chats</h3>
                <a href="@Url.Action("Index", "Chat", new { area = "Student" })" class="view-all-link">View All</a>
            </div>
            <div class="list-group" style="flex: 1; display: flex; flex-direction: column;">
                @if (Model.RecentChats != null && Model.RecentChats.Any())
                {
                    foreach (var chat in Model.RecentChats)
                    {
                        var clubInitials = string.IsNullOrWhiteSpace(chat.Club?.Name) ? "CC" :
                            chat.Club.Name.Length >= 2 ? chat.Club.Name.Substring(0, 2).ToUpper() : chat.Club.Name.ToUpper();

                        <div class="list-item" style="background: transparent; border-bottom: 1px solid rgba(255,255,255,0.05); padding: 12px 10px; box-shadow: none; flex: 1;">
                            <div style="display: flex; gap: 12px; align-items: center; flex: 1; min-width: 0;">
                                <div style="width: 40px; height: 40px; background: #4776e6; border-radius: 50%; display: grid; place-items: center; font-weight: bold; flex-shrink: 0;">@clubInitials</div>
                                <div style="min-width: 0; flex: 1;">
                                    <div style="font-weight: 600; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@(chat.Club?.Name ?? "General")</div>
                                    <div class="item-meta" style="margin-top: 2px;">
                                        <strong style="color: var(--color-accent);">@chat.SenderName:</strong>
                                        @(chat.MessageText.Length > 25 ? chat.MessageText.Substring(0, 25) + "..." : chat.MessageText)
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; color: var(--color-text-secondary); padding: 30px 10px; margin: auto;">No recent chat activity in your clubs.</div>
                }
            </div>
        </div>

    </div>
</div>