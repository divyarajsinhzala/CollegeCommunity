@{
    ViewBag.Title = "Help Center";
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";
}

<div style="max-width: 800px; margin: 0 auto;">
    <h2 style="margin: 0 0 20px 0; text-align: center;">How can we help you?</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: rgba(56, 198, 192, 0.15); border-left: 4px solid var(--color-success); padding: 15px; border-radius: 6px; margin-bottom: 20px; color: white; text-align: center;">
            <i class="fa-solid fa-circle-check" style="color: var(--color-success); margin-right: 5px;"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="search-bar form-control" style="display: flex; align-items: center; gap: 10px; margin-bottom: 40px; border-radius: 30px; padding: 15px 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
        <i class="fa-solid fa-magnifying-glass" style="color: var(--color-text-secondary);"></i>
        <input type="text" placeholder="Search documentation, FAQs, or contact support..." style="background: transparent; border: none; color: white; outline: none; width: 100%; font-size: 1rem;" />
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--spacing-lg); margin-bottom: 40px;">
        <a href="@Url.Action("Guidelines", "Help")" class="card glass-panel" style="text-align: center; padding: 30px 20px; text-decoration: none; display: block; transition: transform 0.2s ease;">
            <i class="fa-solid fa-book" style="font-size: 2rem; color: var(--color-accent); margin-bottom: 15px;"></i>
            <h3 style="margin: 0 0 10px 0; color: white;">Student Guidelines</h3>
            <p style="color: var(--color-text-secondary); font-size: 0.9rem; margin: 0;">Read the official documentation on campus policies and portal usage.</p>
        </a>

        <a href="@Url.Action("Faqs", "Help")" class="card glass-panel" style="text-align: center; padding: 30px 20px; text-decoration: none; display: block; transition: transform 0.2s ease;">
            <i class="fa-solid fa-graduation-cap" style="font-size: 2rem; color: #4776e6; margin-bottom: 15px;"></i>
            <h3 style="margin: 0 0 10px 0; color: white;">Academic FAQs</h3>
            <p style="color: var(--color-text-secondary); font-size: 0.9rem; margin: 0;">Answers to common questions regarding coursework and schedules.</p>
        </a>
    </div>

    <!-- Direct Support Form -->
    <div class="card glass-panel">
        <h3 style="margin: 0 0 20px 0; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;"><i class="fa-solid fa-envelope-open-text" style="color: var(--color-accent); margin-right: 10px;"></i> Contact Administration</h3>

        @using (Html.BeginForm("SubmitFeedback", "Help", FormMethod.Post, new { style = "display: flex; flex-direction: column; gap: 15px;" }))
        {
            @Html.AntiForgeryToken()
            <div>
                <label style="display: block; margin-bottom: 5px; color: var(--color-text-secondary);">Subject / Topic</label>
                <input type="text" name="subject" class="form-control" placeholder="e.g., Portal Bug, Event Question, Club Request" required />
            </div>
            <div>
                <label style="display: block; margin-bottom: 5px; color: var(--color-text-secondary);">Detailed Message</label>
                <textarea name="message" class="form-control" rows="5" placeholder="Describe your issue or provide your feedback here..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="align-self: flex-end; padding: 10px 25px;"><i class="fa-solid fa-paper-plane"></i> Send Ticket</button>
        }
    </div>
</div>